# FolioTrace Environment Variables
# Copy this file to .env and fill in your values

# Free local defaults. Pull qwen3:4b-instruct into the Ollama service first.
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3:4b-instruct
EMBEDDING_PROVIDER=fastembed
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5

# Optional remote providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Optional: improves Semantic Scholar API quota
SEMANTIC_SCHOLAR_API_KEY=
NCBI_API_KEY=
NCBI_EMAIL=
UNPAYWALL_EMAIL=

# Optional: LangSmith tracing for observability
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=foliotrace
