# Backend Environment Variables
# Copy this file to .env and fill in your values

# Defaults require no paid API keys: local FastEmbed + Ollama.
EMBEDDING_PROVIDER=fastembed
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1/
OLLAMA_MODEL=qwen3:4b-instruct

# Optional remote providers (set LLM_PROVIDER=anthropic or deepseek,
# or EMBEDDING_PROVIDER=openai, before adding the matching key)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
SEMANTIC_SCHOLAR_API_KEY=
NCBI_API_KEY=
NCBI_EMAIL=
UNPAYWALL_EMAIL=

# Database (defaults to SQLite in ./data/)
DATABASE_URL=sqlite:///./data/research.db

# Qdrant vector store
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Optional: LangSmith tracing for observability
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=foliotrace
