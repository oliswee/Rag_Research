# Backend Environment Variables
# Copy this file to .env and fill in your values

# Optional: Anthropic API key for extraction and synthesized answers
ANTHROPIC_API_KEY=

# Optional: OpenAI API key for dense embeddings (text-embedding-3-small)
OPENAI_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# Database (defaults to SQLite in ./data/)
DATABASE_URL=sqlite:///./data/research.db

# Qdrant vector store
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Optional: LangSmith tracing for observability
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=foliotrace
