# Backend Environment Variables
# Copy this file to .env and fill in your values

# Required: Anthropic API key for Claude (extraction & synthesis)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Required: OpenAI API key for embeddings (text-embedding-3-small)
OPENAI_API_KEY=sk-proj-your-key-here

# Database (defaults to SQLite in ./data/)
DATABASE_URL=sqlite:///./data/research.db

# Qdrant vector store
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Optional: LangSmith tracing for observability
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=research-vault
